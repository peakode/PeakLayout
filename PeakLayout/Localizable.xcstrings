        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereleri yerleştirmek için Erişilebilirlik izni gerekiyor. Sistem Ayarları › Gizlilik ve Güvenlik › Erişilebilirlik'ten PeakLayout'u aç."
          }
        }
      }
    },
